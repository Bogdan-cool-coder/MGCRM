        "message": "<KanbanCard> doesn't accept that prop. Declared props: title, amount, product, owner, daysInStage, health, task, rotting, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KanbanCard'] > JSXAttribute[name.name='health'] > Literal[value!=/^(?:ok|no-task|overdue)$/]",
        "message": "<KanbanCard> health must be one of 'ok' | 'no-task' | 'overdue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|danger|kbd|sep|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: icon, label, onClick, danger, kbd, sep."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|variant|dot|max|children|style|key|ref|className|style|children)$/]",
        "message": "<NotificationBadge> doesn't accept that prop. Declared props: value, variant, dot, max, children, style."
