      {
        "selector": "JSXOpeningElement[name.name='NotificationBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:danger|primary|warning)$/]",
        "message": "<NotificationBadge> variant must be one of 'danger' | 'primary' | 'warning'."
