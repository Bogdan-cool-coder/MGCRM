        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|icon|type|size|invalid|disabled|fullWidth|onChange|style|key|ref|className|style|children)$/]",
